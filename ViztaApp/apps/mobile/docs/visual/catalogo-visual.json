                "partido",
                "tipo"
              ]
            },
            "forma": {
              "type": "string",
              "enum": [
                "rejilla",
                "lista"
              ]
            }
          },
          "required": [
            "actores"
          ],
          "additionalProperties": false,
          "id": "Actores",
          "description": "Varias personas o entidades del Codex, por id (o los items de un Query), con sus caras. \"rejilla\" para mapear a muchos de un vistazo (precandidatos, una bancada); \"lista\" para leer su cargo y partido. agruparPor \"partido\" los junta por partido."
        },
        "Relaciones": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
