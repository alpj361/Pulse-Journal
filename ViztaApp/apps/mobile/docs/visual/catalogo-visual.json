      },
      "Pestana": {
        "signature": "Pestana(nombre: string, contenido: (Seccion | Texto | Cita | Aviso | Cifras | Barras | Hemiciclo | LineaDeTiempo | Actor | Actores | Relaciones | Personas | Relacion | Hecho)[])",
        "description": "Una pestaña de Pestanas."
      },
      "Texto": {
        "signature": "Texto(texto: string, tono?: \"cuerpo\" | \"meta\" | \"destacado\")",
        "description": "Un párrafo corto. tono \"destacado\" para la idea principal, \"meta\" para aclaraciones."
      },
      "Cita": {
        "signature": "Cita(texto: string, quien?: string)",
        "description": "Una frase literal de alguien, con quién la dijo."
      },
      "Aviso": {
        "signature": "Aviso(texto: string, tono?: \"info\" | \"alerta\")",
        "description": "Una advertencia sobre cómo leer los datos (datos incompletos, fechas, fuentes). Úsalo poco."
      },
      "Cifras": {
        "signature": "Cifras(cifras: Cifra[])",
        "description": "Una fila de cifras, de 2 a 4."
      },
      "Cifra": {
        "signature": "Cifra(valor: string | number, etiqueta: string, detalle?: string)",
        "description": "Un número grande con lo que cuenta («27 partidos vigentes»)."
      },
      "Barras": {
        "signature": "Barras(barras: Barra[], unidad?: string)",
        "description": "Comparar cantidades entre categorías (barras horizontales, de mayor a menor)."
      },
      "Barra": {
        "signature": "Barra(etiqueta: string, valor: number)",
        "description": "Una barra de Barras."
      },
      "Hemiciclo": {
        "signature": "Hemiciclo(favor: number, contra?: number, ausentes?: number, titulo?: string)",
        "description": "Una votación del Congreso (160 curules): votos a favor, en contra y ausentes. Solo con votos contados."
      },
      "LineaDeTiempo": {
        "signature": "LineaDeTiempo(hitos: Hito[])",
        "description": "Qué pasó y cuándo, en orden."
      },
      "Hito": {
        "signature": "Hito(fecha: string, titulo: string, detalle?: string)",
        "description": "Un momento de una LineaDeTiempo. fecha como se lee («12 oct 2026»)."
      },
      "Actor": {
        "signature": "Actor(id: string, nota?: string)",
        "description": "La ficha de UNA persona o entidad del Codex, por su id (búscalo antes con el Codex). Se ve su foto o logo, nombre, cargo y partido; se toca para abrir su ficha. nota: por qué está aquí, en una línea."
      },
      "Actores": {
        "signature": "Actores(actores: (string | {id: string})[], agruparPor?: \"partido\" | \"tipo\", forma?: \"rejilla\" | \"lista\")",
        "description": "Varias personas o entidades del Codex, por id (o los items de un Query), con sus caras. \"rejilla\" para mapear a muchos de un vistazo (precandidatos, una bancada); \"lista\" para leer su cargo y partido. agruparPor \"partido\" los junta por partido."
      },
      "Relaciones": {
        "signature": "Relaciones(id: string, limite?: number)",
        "description": "Con quién y con qué está vinculado un item del Codex (partidos, cargos, alianzas), leído de sus relaciones guardadas."
      },
      "Personas": {
        "signature": "Personas(personas: Persona[])",
        "description": "Personas o entidades de un post (quién aparece, a quién se menciona, qué organizaciones). Los que están en el Codex se ven con su cara y abren su ficha; los que no, con sus iniciales y, en la ficha del post, un + para agregarlos."
      },
      "Persona": {
        "signature": "Persona(texto: string, id?: string, tipo?: string, rol?: string, detalle?: string)",
        "description": "Alguien de un post: su nombre como sale en el post y, si ya está en el Codex, su id. rol: qué hace en el video («conduce», «invitado», «habla a cámara»); detalle: cómo se le reconoce si no tiene nombre."
      },
      "Relacion": {
        "signature": "Relacion(a: string, verbo: string, b: string)",
        "description": "Un vínculo que dice un post («Jev es desarrollado por TypeSafe AI»). En la ficha del post, un + lo guarda en el Codex."
      },
      "Hecho": {
        "signature": "Hecho(id: string, texto: string, cita?: string, quien?: string)",
        "description": "Algo que afirma un post, con su cita literal si la hay. En la ficha del post, se guarda como hecho del Codex."
      }
    },
