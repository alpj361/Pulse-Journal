          "additionalProperties": false,
          "id": "Hemiciclo",
          "description": "Una votación del Congreso (160 curules): votos a favor, en contra y ausentes. Solo con votos contados."
        },
        "LineaDeTiempo": {
          "type": "object",
          "properties": {
            "hitos": {
              "type": "array",
              "items": {
