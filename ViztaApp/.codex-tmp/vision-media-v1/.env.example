# Mistral AI Configuration (Primary - Fine-tuned Agent)
VIZTA_MISTRAL_API_KEY=your_mistral_api_key_here
VIZTA_MISTRAL_AGENT_ID=ag_019a535bfc45757da1152c45da23fbed
VIZTA_MISTRAL_MODEL=mistral-large-latest

# OpenAI Configuration (fallback)
OPENAI_API_KEY=your_openai_api_key_here

# Multimodal analysis
OPENROUTER_API_KEY=your_openrouter_api_key_here
IMAGE_VISION_MODEL=qwen/qwen3.7-flash
VIDEO_VISION_MODEL=google/gemini-3.8-flash
VIDEO_AGENTIC_THRESHOLD_SECONDS=300
VIDEO_BASE64_LIMIT_BYTES=104857600

# AWS Rekognition. Prefer an IAM user/role restricted to the required actions.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
# AWS_SESSION_TOKEN=your_optional_session_token
# Configure this only when the future face-indexing workflow is defined.
# AWS_REKOGNITION_COLLECTION_ID=vizta-faces

# Supabase Configuration
SUPABASE_URL=your_supabase_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ========================================
# ELEVENLABS CONFIGURATION (NEW)
# ========================================
# API Key for ElevenLabs Scribe - Real-time Speech-to-Text
# Get your API key from: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# ElevenLabs Configuration (Optional)
ELEVENLABS_DEFAULT_LANGUAGE=es
ELEVENLABS_ENABLE_TIMESTAMPS=true
ELEVENLABS_ENABLE_PUNCTUATION=true
ELEVENLABS_ENABLE_NUMBER_FORMATTING=true

# Real-time Transcription Settings
REALTIME_TRANSCRIPTION_ENABLED=true
REALTIME_WS_PORT=8081

# Other required variables
# Add your other environment variables here...
