          "required": [
            "id"
          ],
          "additionalProperties": false,
          "id": "Actor",
          "description": "La ficha de UNA persona o entidad del Codex, por su id (búscalo antes con el Codex). Se ve su foto o logo, nombre, cargo y partido; se toca para abrir su ficha. nota: por qué está aquí, en una línea."
        },
        "Actores": {
          "type": "object",
          "properties": {
            "actores": {
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "id"
                    ],
                    "additionalProperties": {}
                  }
                ]
              }
            },
