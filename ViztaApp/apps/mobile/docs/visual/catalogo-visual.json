          },
          "required": [
            "personas"
          ],
          "additionalProperties": false,
          "id": "Personas",
          "description": "Personas o entidades de un post (quién aparece, a quién se menciona, qué organizaciones). Los que están en el Codex se ven con su cara y abren su ficha; los que no, con sus iniciales y, en la ficha del post, un + para agregarlos."
        },
        "Persona": {
          "type": "object",
          "properties": {
            "texto": {
              "type": "string"
            },
            "id": {
              "type": "string"
            },
            "tipo": {
              "type": "string"
            },
            "rol": {
              "type": "string"
            },
            "detalle": {
              "type": "string"
            }
          },
          "required": [
            "texto"
          ],
          "additionalProperties": false,
          "id": "Persona",
          "description": "Alguien de un post: su nombre como sale en el post y, si ya está en el Codex, su id. rol: qué hace en el video («conduce», «invitado», «habla a cámara»); detalle: cómo se le reconoce si no tiene nombre."
        },
        "Relacion": {
          "type": "object",
          "properties": {
            "a": {
              "type": "string"
            },
            "verbo": {
              "type": "string"
            },
            "b": {
              "type": "string"
            }
          },
          "required": [
            "a",
            "verbo",
            "b"
          ],
          "additionalProperties": false,
          "id": "Relacion",
          "description": "Un vínculo que dice un post («Jev es desarrollado por TypeSafe AI»). En la ficha del post, un + lo guarda en el Codex."
        },
        "Hecho": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "texto": {
              "type": "string"
            },
            "cita": {
              "type": "string"
            },
            "quien": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "texto"
          ],
          "additionalProperties": false,
          "id": "Hecho",
          "description": "Algo que afirma un post, con su cita literal si la hay. En la ficha del post, se guarda como hecho del Codex."
        },
        "Pestanas": {
          "type": "object",
          "properties": {
            "pestanas": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Pestana"
              }
            }
          },
          "required": [
            "pestanas"
          ],
          "additionalProperties": false,
          "id": "Pestanas",
          "description": "Pestañas para separar vistas de lo mismo (por partido, por tema). De 2 a 5."
        },
        "Pestana": {
          "type": "object",
          "properties": {
            "nombre": {
              "type": "string"
            },
            "contenido": {
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/Seccion"
                  },
                  {
                    "anyOf": [
                      {
                        "$ref": "#/$defs/Texto"
                      },
                      {
                        "$ref": "#/$defs/Cita"
                      },
                      {
                        "$ref": "#/$defs/Aviso"
                      },
                      {
                        "$ref": "#/$defs/Cifras"
                      },
                      {
                        "$ref": "#/$defs/Barras"
                      },
                      {
                        "$ref": "#/$defs/Hemiciclo"
                      },
                      {
                        "$ref": "#/$defs/LineaDeTiempo"
                      },
                      {
                        "$ref": "#/$defs/Actor"
                      },
                      {
                        "$ref": "#/$defs/Actores"
                      },
                      {
                        "$ref": "#/$defs/Relaciones"
                      },
                      {
                        "$ref": "#/$defs/Personas"
                      },
                      {
                        "$ref": "#/$defs/Relacion"
                      },
                      {
                        "$ref": "#/$defs/Hecho"
                      }
                    ]
                  }
                ]
              }
            }
          },
          "required": [
            "nombre",
            "contenido"
          ],
          "additionalProperties": false,
          "id": "Pestana",
          "description": "Una pestaña de Pestanas."
        }
      }
    }
