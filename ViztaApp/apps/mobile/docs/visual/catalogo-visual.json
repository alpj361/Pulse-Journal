    "root": "Vista",
    "components": {
      "Vista": {
        "signature": "Vista(titulo: string, contenido: (Seccion | Pestanas | Texto | Cita | Aviso | Cifras | Barras | Hemiciclo | LineaDeTiempo | Actor | Actores | Relaciones | Personas | Relacion | Hecho)[], bajada?: string)",
        "description": "La raíz: título, una bajada de una línea con lo que se ve, y su contenido."
      },
      "Seccion": {
        "signature": "Seccion(titulo: string, contenido: (Texto | Cita | Aviso | Cifras | Barras | Hemiciclo | LineaDeTiempo | Actor | Actores | Relaciones | Personas | Relacion | Hecho)[], icono?: \"actores\" | \"actor\" | \"entidad\" | \"congreso\" | \"relaciones\" | \"tiempo\" | \"noticias\" | \"cifras\" | \"lugar\" | \"cita\" | \"info\")",
        "description": "Un bloque con título. icono: actores, actor, entidad, congreso, relaciones, tiempo, noticias, cifras, lugar, cita, info."
      },
      "Pestanas": {
        "signature": "Pestanas(pestanas: Pestana[])",
